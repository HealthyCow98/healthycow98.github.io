---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return [...new Set(posts.flatMap(p => p.data.tags))].map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(p => p.data.tags.includes(tag)).sort((a,b) => b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf()) } }));
}
const { tag, posts } = Astro.props;
---
<Base title={tag}><section class="page-heading"><a class="back" href="/tags/">← 모든 태그</a><h1>{tag}</h1><p>{posts.length}개의 기록</p></section>{posts.map((post, index) => <PostCard post={post} index={index} />)}</Base>
